# AeroResolve Environment Configuration Example
# NEVER commit real credentials or secrets to version control.

# Snowflake Connection Configuration
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ROLE=AERORESOLVE_DEV
SNOWFLAKE_WAREHOUSE=AERORESOLVE_WH
SNOWFLAKE_DATABASE=AERORESOLVE
SNOWFLAKE_SCHEMA=APP

# Streamlit / App Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# External MCP Integrations (Optional / Human Gated)
JIRA_INSTANCE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=user@example.com
# Use OAuth or CoCo CLI credential store; do not place API tokens in plaintext here.

# Simulation Settings
SIMULATION_SPEED_MULTIPLIER=30
DATA_PROFILE=DEMO
RANDOM_SEED=42
